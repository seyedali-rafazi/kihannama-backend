  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL for KihanNama API server"
    },
    {
      "key": "noradId",
      "value": "25544",
      "type": "string",
      "description": "Sample NORAD Catalog ID (e.g. 25544 for ISS)"
    },
    {
      "key": "stationSlug",
      "value": "iss",
      "type": "string",
      "description": "Sample Space Station slug or identifier"
    },
    {
      "key": "groundStationId",
      "value": "goldstone",
      "type": "string",
      "description": "Sample Ground Station identifier"
    },
    {
      "key": "launcherId",
