    {
      "name": "2. Satellites",
      "description": "Satellite queries, catalog search, details, and Cesium CZML payloads",
      "item": [
        {
          "name": "List Satellites (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/satellites?search=STARLINK&orbit_class=LEO&page=1&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "satellites"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "STARLINK",
                  "description": "Search query for satellite name or NORAD ID"
                },
                {
                  "key": "orbit_class",
                  "value": "LEO",
                  "description": "Orbit classification: LEO, MEO, GEO, HEO"
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true,
                  "description": "Satellite category"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (starts from 1)"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Number of items per page (1 to 500)"
                }
              ]
            },
            "description": "Retrieve paginated list of satellites with optional filters."
          },
          "response": []
        },
        {
          "name": "Get Satellite by NORAD ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/satellites/{{noradId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "satellites",
                "{{noradId}}"
              ]
            },
            "description": "Get detailed metadata, orbital parameters, and classification for a satellite by NORAD ID (e.g. 25544)."
          },
          "response": []
        },
        {
          "name": "Satellites CZML Stream (Batch)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/satellites/czml?limit=25&orbit_class=LEO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "satellites",
                "czml"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25",
                  "description": "Max satellites to include in CZML (1 to 250)"
                },
                {
                  "key": "orbit_class",
                  "value": "LEO",
                  "description": "Filter by LEO, MEO, GEO"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by satellite name"
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true,
                  "description": "Filter by category"
                },
                {
                  "key": "norad_ids",
                  "value": "",
                  "disabled": true,
                  "description": "Comma-separated NORAD IDs"
                }
              ]
            },
            "description": "Generates Cesium-compatible CZML document packets for visualizing satellite orbits."
          },
          "response": []
        },
        {
          "name": "Single Satellite CZML Orbit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/satellites/{{noradId}}/czml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "satellites",
                "{{noradId}}",
                "czml"
              ]
            },
            "description": "Generates CZML orbit packet for a specific satellite NORAD ID."
          },
          "response": []
        }
      ]
    },
